{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://discord.com https://*.discordapp.com https://*.discord.com;"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOW-FROM https://discord.com"
        }
      ]
    }
  ]
}
